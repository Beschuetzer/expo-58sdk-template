{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/api",
    "rootDir": "../../",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "paths": {
      "@expo-50sdk-template/shared-types": [
        "../../libs/shared-types/src/index.ts"
      ],
      "@expo-50sdk-template/logging": [
        "../../libs/logging/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "prisma/seed-featured-users.ts",
    "prisma/seed-featured-users.spec.ts",
    "../../libs/shared-types/src/**/*.ts"
  ]
}

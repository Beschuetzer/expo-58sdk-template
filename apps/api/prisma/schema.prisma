generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Example {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String?  @unique

  @@map("examples")
}

enum NotificationDeliveryStatus {
  pending
  delivered
  failed
}

enum PushTokenPlatform {
  ios
  android
}

model Notification {
  id                   String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime                   @default(now())
  recipientUserId      String
  eventId              String                     @db.ObjectId
  targetType           String?
  targetId             String?
  title                String
  body                 String
  readAt               DateTime?
  deliveryStatus       NotificationDeliveryStatus @default(pending)

  @@index([eventId])
  @@index([recipientUserId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPushToken {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  token     String            @unique
  userId    String
  platform  PushTokenPlatform

  @@index([userId])
  @@map("notification_push_tokens")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Example {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String?  @unique

  @@map("examples")
}

enum ApprovalPolicy {
  all_members
}

enum RelationshipRole {
  owner
  member
}

enum PaymentRequestStatus {
  draft
  pending_approval
  approved
  rejected
  cancelled
}

enum JointAccountChargeStatus {
  unpaid
  paid
}

enum BudgetPeriod {
  monthly
  quarterly
  yearly
}

enum BudgetStatus {
  pending_approval
  approved
}

enum RelationshipRuleStatus {
  pending_approval
  ratified
}

enum PaymentRequestDecisionType {
  approved
  rejected
  changes_requested
}

enum ActivityEventType {
  created
  edited
  submitted
  approved
  rejected
  changes_requested
  cancelled
}

enum NotificationDeliveryStatus {
  pending
  delivered
  failed
}

enum PushTokenPlatform {
  ios
  android
}

enum SexCoinSide {
  heads
  tails
}

model Relationship {
  id                  String                    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  name                String
  shareCode           String?                   @unique
  approvalPolicy      ApprovalPolicy            @default(all_members)
  members             RelationshipMember[]
  requests            PaymentRequest[]
  jointAccountCharges JointAccountCharge[]
  budgets             Budget[]
  rules               RelationshipRule[]
  meTimeEntries       MeTime[]
  tasks               RelationshipTask[]
  sexCoinFlips        SexCoinFlip[]
  sexEvents           SexEvent[]
  dateNightEvents     DateNightEvent[]
  rubrics             Rubric[]
  invitations         RelationshipInvitation[]
  joinRequests        RelationshipJoinRequest[]

  @@map("relationships")
}

model RelationshipMember {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  relationshipId String           @db.ObjectId
  userId         String
  displayName    String?
  role           RelationshipRole @default(member)
  active         Boolean          @default(true)
  relationship   Relationship     @relation(fields: [relationshipId], references: [id])

  @@unique([relationshipId, userId])
  @@index([userId, active])
  @@map("relationship_members")
}

enum RelationshipInvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model RelationshipInvitation {
  id               String                       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime                     @default(now())
  relationshipId   String                       @db.ObjectId
  inviterUserId    String
  inviteeEmail     String?
  tokenHash        String                       @unique
  status           RelationshipInvitationStatus @default(pending)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  relationship     Relationship                 @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, status, createdAt])
  @@index([status, expiresAt])
  @@map("relationship_invitations")
}

enum RelationshipJoinRequestStatus {
  pending
  approved
  rejected
}

model RelationshipJoinRequest {
  id                   String                        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  relationshipId       String                        @db.ObjectId
  requesterUserId      String
  requesterDisplayName String?
  status               RelationshipJoinRequestStatus @default(pending)
  respondedAt          DateTime?
  respondedByUserId    String?
  relationship         Relationship                  @relation(fields: [relationshipId], references: [id])

  @@unique([relationshipId, requesterUserId, status])
  @@index([relationshipId, status, createdAt])
  @@index([requesterUserId, status])
  @@map("relationship_join_requests")
}

model PaymentRequest {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  relationshipId   String                    @db.ObjectId
  createdByUserId  String
  title            String
  rationale        String
  amountMinorUnits Int
  currency         String
  purchaseDate     DateTime
  categories       String[]                  @default([])
  requestedSplit   Json
  status           PaymentRequestStatus      @default(draft)
  rubricVersionId  String?                   @db.ObjectId
  resolvedAt       DateTime?
  relationship     Relationship              @relation(fields: [relationshipId], references: [id])
  rubricVersion    RubricVersion?            @relation(fields: [rubricVersionId], references: [id])
  evaluation       PaymentRequestEvaluation?
  decisions        PaymentRequestDecision[]
  activity         ActivityEvent[]

  @@index([relationshipId, status, createdAt])
  @@index([createdByUserId, status])
  @@map("payment_requests")
}

model JointAccountCharge {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  relationshipId   String                   @db.ObjectId
  createdByUserId  String
  updatedByUserId  String?
  paymentRequestId String?                  @db.ObjectId
  name             String
  amountMinorUnits Int
  chargeDate       DateTime                 @default(now())
  status           JointAccountChargeStatus @default(unpaid)
  relationship     Relationship             @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, status, chargeDate])
  @@index([relationshipId, createdByUserId])
  @@index([paymentRequestId])
  @@map("joint_account_charges")
}

model Budget {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  relationshipId   String           @db.ObjectId
  seriesId         String           @db.ObjectId
  createdByUserId  String
  updatedByUserId  String?
  name             String
  amountMinorUnits Int
  currency         String?          @default("USD")
  period           BudgetPeriod
  periodStart      DateTime
  periodEnd        DateTime
  renewedAt        DateTime?
  status           BudgetStatus     @default(pending_approval)
  relationship     Relationship     @relation(fields: [relationshipId], references: [id])
  approvals        BudgetApproval[]
  items            BudgetItem[]

  @@unique([seriesId, periodStart])
  @@index([relationshipId, periodStart])
  @@index([status, periodEnd, renewedAt])
  @@map("budgets")
}

model BudgetApproval {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  budgetId     String    @db.ObjectId
  memberUserId String
  approvedAt   DateTime?
  budget       Budget    @relation(fields: [budgetId], references: [id])

  @@unique([budgetId, memberUserId])
  @@index([memberUserId, approvedAt])
  @@map("budget_approvals")
}

model BudgetItem {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime @default(now())
  budgetId         String   @db.ObjectId
  createdByUserId  String
  name             String
  amountMinorUnits Int
  date             DateTime
  budget           Budget   @relation(fields: [budgetId], references: [id])

  @@index([budgetId, date])
  @@map("budget_items")
}

model RelationshipRule {
  id               String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  relationshipId   String                     @db.ObjectId
  createdByUserId  String
  name             String
  labels           String[]                   @default([])
  description      String
  status           RelationshipRuleStatus     @default(pending_approval)
  ratifiedAt       DateTime?
  remindMeToReview DateTime?
  reminderSentAt   DateTime?
  relationship     Relationship               @relation(fields: [relationshipId], references: [id])
  approvals        RelationshipRuleApproval[]

  @@index([relationshipId, status, createdAt])
  @@index([relationshipId, createdByUserId])
  @@index([remindMeToReview, reminderSentAt])
  @@map("relationship_rules")
}

model MeTime {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  relationshipId  String       @db.ObjectId
  createdByUserId String
  updatedByUserId String?
  startTime       DateTime
  endTime         DateTime
  description     String?
  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, startTime])
  @@index([relationshipId, createdByUserId])
  @@map("me_time")
}

model RelationshipTask {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  updatedByUserId      String?
  lastEditedAt         DateTime?
  lastEditedFields     String[]     @default([])
  relationshipId       String       @db.ObjectId
  createdByUserId      String
  name                 String
  dueDate              DateTime?
  lastReminderSentAt   DateTime?
  reminderFrequencyDays Int          @default(1)
  visibleToUserIds     String[]     @default([])
  completableByUserIds String[]     @default([])
  completedAt          DateTime?
  completedByUserId    String?
  relationship         Relationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, createdAt])
  @@index([relationshipId, completedAt])
  @@index([dueDate, completedAt, lastReminderSentAt])
  @@map("relationship_tasks")
}

model SexCoinFlip {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime     @default(now())
  relationshipId  String       @db.ObjectId
  day             String
  memberSetKey    String
  memberUserIds   String[]     @default([])
  createdByUserId String
  guess           SexCoinSide
  outcome         SexCoinSide
  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  @@unique([relationshipId, day])
  @@index([relationshipId, memberSetKey, day])
  @@map("sex_coin_flips")
}

model SexEvent {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime     @default(now())
  relationshipId  String       @db.ObjectId
  day             String
  memberSetKey    String
  memberUserIds   String[]     @default([])
  createdByUserId String
  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, memberSetKey, day])
  @@index([relationshipId, createdByUserId, createdAt])
  @@index([relationshipId, day, createdAt, id])
  @@map("sex_events")
}

model DateNightEvent {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime     @default(now())
  relationshipId  String       @db.ObjectId
  day             String
  description     String?
  createdByUserId String
  relationship    Relationship @relation(fields: [relationshipId], references: [id])

  @@index([relationshipId, day, createdAt, id])
  @@map("date_night_events")
}

model RelationshipRuleApproval {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ruleId           String           @db.ObjectId
  memberUserId     String
  agreedAt         DateTime?
  relationshipRule RelationshipRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, memberUserId])
  @@index([memberUserId, agreedAt])
  @@map("relationship_rule_approvals")
}

model PaymentRequestDecision {
  id               String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  paymentRequestId String                     @db.ObjectId
  memberUserId     String
  decision         PaymentRequestDecisionType
  comment          String?
  paymentRequest   PaymentRequest             @relation(fields: [paymentRequestId], references: [id])

  @@unique([paymentRequestId, memberUserId])
  @@index([memberUserId, createdAt])
  @@map("payment_request_decisions")
}

model Rubric {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  relationshipId String          @db.ObjectId
  name           String
  relationship   Relationship    @relation(fields: [relationshipId], references: [id])
  versions       RubricVersion[]

  @@index([relationshipId])
  @@map("rubrics")
}

model RubricVersion {
  id          String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime                   @default(now())
  rubricId    String                     @db.ObjectId
  version     Int
  questions   Json
  published   Boolean                    @default(true)
  rubric      Rubric                     @relation(fields: [rubricId], references: [id])
  requests    PaymentRequest[]
  evaluations PaymentRequestEvaluation[]

  @@unique([rubricId, version])
  @@map("rubric_versions")
}

model PaymentRequestEvaluation {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentRequestId String         @unique @db.ObjectId
  rubricVersionId  String         @db.ObjectId
  answers          Json
  recommendation   String?
  score            Float?
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id])
  rubricVersion    RubricVersion  @relation(fields: [rubricVersionId], references: [id])

  @@map("payment_request_evaluations")
}

model ActivityEvent {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime          @default(now())
  paymentRequestId String            @db.ObjectId
  actorUserId      String
  eventType        ActivityEventType
  metadata         Json
  paymentRequest   PaymentRequest    @relation(fields: [paymentRequestId], references: [id])

  @@index([paymentRequestId, createdAt])
  @@map("activity_events")
}

model Notification {
  id                   String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime                   @default(now())
  recipientUserId      String
  eventId              String                     @db.ObjectId
  targetType           String?
  targetId             String?
  targetRelationshipId String?
  title                String
  body                 String
  readAt               DateTime?
  deliveryStatus       NotificationDeliveryStatus @default(pending)

  @@index([eventId])
  @@index([recipientUserId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPushToken {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  token     String            @unique
  userId    String
  platform  PushTokenPlatform

  @@index([userId])
  @@map("notification_push_tokens")
}

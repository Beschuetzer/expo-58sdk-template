{
  "name": "mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "apphost:dev": "expo start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ../../package.json --runInBand --watchAll=false",
    "test:coverage": "jest --config ../../package.json --coverage --runInBand --watchAll=false",
    "validate": "expo config --type public --json && expo-doctor",
    "build-production": "npx --yes eas-cli@latest build --platform all --profile production --auto-submit",
    "build-and-submit-production-android": "npx --yes eas-cli@latest build --platform android --profile production --auto-submit",
    "build-preview": "npx --yes eas-cli@latest build -p android --profile preview"

{
  "name": "relationship-app",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "api:build": "npm run prisma:generate --workspace=api && npm run build --workspace=libs/shared-types && npm run build --workspace=libs/logging && npm run build --workspace=api",
    "api:start": "node dist/apps/api/main.js",
    "init": "node scripts/init.js",
    "build:preview": "npm run build-preview --workspace=mobile",
    "build:production": "npm run build-production --workspace=mobile",
    "build-and-submit:production:android": "npm run build-and-submit-production-android --workspace=mobile",
    "build": "npm run api:build",
    "dev": "dotnet run --project AppHost",
    "doctor": "npm run doctor --workspace=mobile",
    "deploy:all": "node scripts/deploy-all.mjs",
    "heroku:setup": "node scripts/setup-heroku.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "start": "npm run dev",
    "test:all": "npm run test --workspace=libs/logging && npm run test --workspace=api && npm run test --workspace=mobile",
    "test:coverage": "npm run test:coverage --workspace=mobile",
    "test": "npm run test --workspace=mobile",
    "typecheck": "npm run typecheck --workspace=libs/shared-types && npm run typecheck --workspace=libs/logging && npm run typecheck --workspace=mobile && npm run typecheck --workspace=api",
    "validate:mobile": "npm run validate --workspace=mobile"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "apps/mobile",
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@expo-50sdk-template/logging$": "<rootDir>/../../libs/logging/src/index.ts",
      "^@expo-50sdk-template/shared-types$": "<rootDir>/../../libs/shared-types/src/index.ts",
      "^react-native-css-interop/jsx-runtime$": "react/jsx-runtime",
      "^react-native-css-interop/jsx-dev-runtime$": "react/jsx-dev-runtime"
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@gluestack-ui|@legendapp))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest-setup.ts"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.7.1",
    "jose": "^4.15.9",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@react-native/jest-preset": "^0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "expo-doctor": "^1.21.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.2.5",
    "react": "19.3.0",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "template": {
    "description": "Expo SDK 58 starter shell with reusable app architecture and a neutral landing/settings flow.",
    "sampleDomain": [
      "starter home screen",
      "starter settings screen",
      "generic feature cards"
    ],
    "reusableShell": [
      "expo-router",
      "redux-toolkit",
      "persisted state",
      "gluestack-ui",
      "shared utilities and hooks"
    ],
    "appSpecificPackages": [
      "expo-camera",
      "expo-share-intent",
      "sample task-domain modules"
    ]
  }
}
